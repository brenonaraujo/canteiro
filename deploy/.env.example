# Local snapshot. Copy to repo-root .env (never commit .env).
PORT=8080
GIN_MODE=debug
LOG_LEVEL=info
METRICS_PATH=/metrics
SERVICE_NAME=canteiro
DEFAULT_LOCALE=pt-BR
SHUTDOWN_TIMEOUT=30s
POSTGRES_USER=canteiro
POSTGRES_PASSWORD=canteiro
POSTGRES_DB=canteiro
DATABASE_URL=postgres://canteiro:canteiro@postgres:5432/canteiro?sslmode=disable
# F1 Conta — Google is a backing service (DoD D4). Leave GOOGLE_* and
# SESSION_SECRET empty to boot the API (GET /auth/google → 503). Fill
# them in repo-root .env for a real Google snapshot. Never commit secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
SESSION_SECRET=
WEB_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=canteiro_session
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h
