# Portainer / docker stack deploy env. Copy to deploy/swarm/.env (gitignored).
# Leave secrets empty here. Real values live only in the runtime (Portainer
# stack env). Empty GOOGLE_* / SESSION_SECRET → API boots; GET /auth/google
# returns 503 not_configured; /healthz and /readyz stay 200.
#
# SESSION_SECRET must be ≥ 16 bytes when Google login is enabled.
POSTGRES_USER=canteiro
POSTGRES_PASSWORD=
POSTGRES_DB=canteiro
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://canteiro.brenon.cloud/auth/google/callback
SESSION_SECRET=
SERVICE_TAG=latest
EDGE_PUBLISHED_PORT=18083
